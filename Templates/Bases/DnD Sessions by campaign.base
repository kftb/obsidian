filters:
  and:
    - campaign.contains(this.file.name)
views:
  - type: table
    name: Generic
    filters:
      and:
        - file.tags.contains("session")
        - file.folder == "Notes/dnd"
    order:
      - file.name
      - date
      - title
      - description
    columnSize:
      note.date: 142
      note.title: 236
      note.description: 635
  - type: table
    name: EoaLN
    filters:
      and:
        - file.tags.contains("eoaln")
        - file.tags.contains("session")
        - file.folder == "Notes/dnd"
    order:
      - file.name
      - date
      - chapter
      - description
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 164
      note.date: 142
      note.chapter: 354
      note.description: 660
