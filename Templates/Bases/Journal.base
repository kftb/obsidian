filters:
  and:
    - '!file.name.contains("Template")'
    - tags.contains("daily")
properties:
  file.name:
    displayName: Entry
  note.created:
    displayName: Created
views:
  - type: table
    name: Table
    order:
      - file.name
      - created
      - mood
    columnSize:
      file.name: 272
