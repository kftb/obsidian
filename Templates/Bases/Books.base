filters:
  and:
    - categories.contains(link("Books"))
    - '!file.name.contains("Template")'
properties:
  note.author:
    displayName: author
  file.name:
    displayName: name
  note.year:
    displayName: year
  note.genre:
    displayName: Genre
views:
  - type: table
    name: Books
    order:
      - file.name
      - series
      - author
      - year
      - rating
      - start
      - end
      - status
      - type
      - note.note
    sort:
      - property: file.name
        direction: DESC
      - property: status
        direction: ASC
      - property: end
        direction: ASC
    columnSize:
      note.series: 189
      note.year: 54
      note.rating: 75
      note.start: 151
      note.end: 144
      note.status: 98
  - type: table
    name: Top rated
    order:
      - file.name
      - rating
      - last
    sort:
      - property: last
        direction: DESC
  - type: table
    name: Author
    filters:
      and:
        - list(author).contains(this)
    order:
      - file.name
      - year
      - genre
    sort:
      - property: genre
        direction: ASC
  - type: table
    name: Genre
    filters:
      and:
        - list(genre).contains(this)
    order:
      - file.name
      - year
      - genre
  - type: table
    name: Read
    order:
      - file.name
      - type
      - genre
      - rating
      - start
      - end
  - type: table
    name: View
  - type: table
    name: View 2
